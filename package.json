{
  "name": "tasan",
  "version": "0.0.0",
  "description": "Web app to split bills ",
  "homepage": "https://tasan.app",
  "author": "Santeri Hiltunen <santeri@santeri.consulting> (https://santeri.consulting)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilzu/tasan.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": "^10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "fix": "node --run format && eslint --fix .",
    "format": "prettier --write .",
    "test": "pnpm -r test && concurrently --group node:test:*",
    "test:format": "prettier --check .",
    "test:lint": "eslint ."
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "catalog:",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n": "^17.15.1",
    "globals": "^15.14.0",
    "prettier": "3.4.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.19.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/node": "catalog:"
    }
  }
}
