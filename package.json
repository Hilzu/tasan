{
  "name": "tasan",
  "version": "0.0.0",
  "description": "Web app to split bills ",
  "homepage": "https://tasan.app",
  "author": "Santeri Hiltunen <santeri@santeri.consulting> (https://santeri.consulting)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilzu/tasan.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.11.0",
    "pnpm": "^10.2.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "tsc --build --clean && pnpm -r clean",
    "dev": "tsc --build --watch",
    "fix": "eslint --fix . && node --run format",
    "format": "prettier --write .",
    "test": "pnpm -r test && concurrently --group node:test:*",
    "test:format": "prettier --check .",
    "test:lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "catalog:",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-n": "^17.15.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.15.0",
    "prettier": "3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "catalog:",
    "typescript-eslint": "^8.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/node": "catalog:"
    }
  }
}
