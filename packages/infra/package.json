{
  "name": "@tasan/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/cdk-app.js",
  "scripts": {
    "access:deploy": "cdk deploy --app 'node --enable-source-maps dist/access-app.js' --output cdk.out/access TasanDeploymentAccessStack",
    "access:diff": "cdk diff --app 'node --enable-source-maps dist/access-app.js' --output cdk.out/access --method template TasanDeploymentAccessStack",
    "access:synth": "cdk synth --app 'node --enable-source-maps dist/access-app.js' --output cdk.out/access",
    "build": "tsc && pnpm build:edge",
    "cdk:diff": "cdk diff",
    "cdk:synth": "cdk synth",
    "clean": "rm -rf cdk.out dist",
    "deploy": "pnpm build-and-sync && cdk deploy --all",
    "start": "node --enable-source-maps .",
    "test": "pnpm build && node --test dist/*.test.js",
    "build-and-sync": "../../scripts/build-and-sync.sh",
    "build:edge": "esbuild src/app-origin-request/main.mts --bundle --platform=node --target=node24.22 --format=esm --outfile=dist/app-origin-request/main.mjs"
  },
  "engines": {
    "node": "^24.22.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "aws-cdk": "^2.1149.0",
    "esbuild": "^0.28.2",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1173.0",
    "@tasan/common": "workspace:*",
    "@tasan/web": "workspace:*",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1",
    "react-router": "catalog:"
  }
}
