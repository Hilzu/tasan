{
  "name": "@tasan/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/cdk-app.js",
  "scripts": {
    "access:deploy": "cdk deploy --app 'node --enable-source-maps dist/access-app.js' --output cdk.out/access TasanDeploymentAccessStack",
    "access:diff": "cdk diff --app 'node --enable-source-maps dist/access-app.js' --output cdk.out/access --method template TasanDeploymentAccessStack",
    "access:synth": "cdk synth --app 'node --enable-source-maps dist/access-app.js' --output cdk.out/access",
    "build": "tsc",
    "cdk:diff": "cdk diff",
    "cdk:synth": "cdk synth",
    "clean": "rm -rf cdk.out dist",
    "deploy": "pnpm build-and-sync && cdk deploy --all",
    "start": "node --enable-source-maps .",
    "test": "pnpm build && node --test dist/*.test.js",
    "build-and-sync": "../../scripts/build-and-sync.sh"
  },
  "engines": {
    "node": "^24.16.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "catalog:",
    "aws-cdk": "^2.1128.0",
    "esbuild": "^0.28.1",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@tasan/web": "workspace:*",
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.6.0",
    "react-router": "catalog:"
  }
}
